# ── Required ────────────────────────────────────────────────────────────────
# Your free Google AI Studio API key: https://aistudio.google.com/apikey
# This key is used ONLY on the server. Never use the NEXT_PUBLIC_ prefix here.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# ── Optional ────────────────────────────────────────────────────────────────
# Gemini model ID. Default: gemini-3.5-flash
# If your key cannot access the default, choose another model from
# https://ai.google.dev/gemini-api/docs/models (for example a "latest" alias).
GEMINI_MODEL=gemini-3.5-flash

# Maximum output tokens per response. Default: 2048
# GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Optional: PostgreSQL chat history ───────────────────────────────────────
# If set, all conversations are stored server-side in PostgreSQL.
# If omitted, the app falls back to documented local-only mode
# (history is stored in the browser's localStorage on that device only).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat
